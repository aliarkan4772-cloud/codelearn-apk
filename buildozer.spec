[app]
title = CodeLearn
package.name = codelearn
package.domain = org.codelearn
source.dir = .
source.include_exts = py,db
version = 6.0
requirements = python3,kivy,pyjnius
orientation = portrait
fullscreen = 1
android.permissions = INTERNET
android.api = 30
android.minapi = 21
android.archs = arm64-v8a

[buildozer]
log_level = 2
warn_on_root = 1
